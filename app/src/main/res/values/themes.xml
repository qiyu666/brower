<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NovaBrowser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <!-- API 31+ 自定义闪屏 -->
    <style name="Theme.NovaBrowser.Splash" parent="Theme.NovaBrowser">
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <!-- 桌面小组件单元格（RemoteViews 只能引用应用内样式） -->
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/widget_cell_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
</resources>
